{"info":{"_postman_id":"expense-tracker-mern-api","description":"Expense Tracker MERN API — Express + MongoDB. Run the requests in order: Create Expense saves the new id to {{expense_id}}.","name":"Expense Tracker MERN API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"event":[{"listen":"test","script":{"exec":["var json = pm.response.json();","if (json.id) { pm.collectionVariables.set('expense_id', json.id); }"],"type":"text/javascript"}}],"name":"Create Expense","request":{"body":{"mode":"raw","raw":"{\n  \"description\": \"Groceries at Big Bazaar\",\n  \"amount\": 49.99,\n  \"category\": \"FOOD\",\n  \"date\": \"2026-11-13\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/expenses"}},{"name":"Get All Expenses","request":{"method":"GET","url":"{{base_url}}/api/expenses"}},{"name":"Get Expense by ID","request":{"method":"GET","url":"{{base_url}}/api/expenses/{{expense_id}}"}},{"name":"Update Expense","request":{"body":{"mode":"raw","raw":"{\n  \"description\": \"Groceries at Big Bazaar (weekly)\",\n  \"amount\": 59.99,\n  \"category\": \"FOOD\",\n  \"date\": \"2026-11-13\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"PUT","url":"{{base_url}}/api/expenses/{{expense_id}}"}},{"name":"Get Expenses by Category","request":{"method":"GET","url":"{{base_url}}/api/expenses/category/FOOD"}},{"name":"Get Expenses by Date Range","request":{"method":"GET","url":{"host":["{{base_url}}"],"path":["api","expenses","date-range"],"query":[{"key":"start","value":"2026-11-01"},{"key":"end","value":"2026-11-30"}],"raw":"{{base_url}}/api/expenses/date-range?start=2026-11-01&end=2026-11-30"}}},{"name":"Get Spending Summary","request":{"method":"GET","url":"{{base_url}}/api/expenses/summary"}},{"name":"Delete Expense","request":{"method":"DELETE","url":"{{base_url}}/api/expenses/{{expense_id}}"}},{"name":"Get Missing Expense (404)","request":{"method":"GET","url":"{{base_url}}/api/expenses/000000000000000000000000"}}],"variable":[{"key":"base_url","value":"http://localhost:5000"},{"key":"expense_id","value":""}]}